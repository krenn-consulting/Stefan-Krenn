      "grammatik": {
        "titel": "Grüße nach Tageszeit – und obrigado oder obrigada?",
        "erklaerung": [
          "<b>Bom dia</b> sagt man morgens bis zum Mittagessen (ca. 12–13 Uhr), <b>boa tarde</b> am Nachmittag, bis es dunkel wird, und <b>boa noite</b> am Abend – zur Begrüßung <i>und</i> zum Abschied.",
          "Warum <b>bom</b> dia, aber <b>boa</b> tarde? <i>Dia</i> (Tag) ist männlich, <i>tarde</i> (Nachmittag) und <i>noite</i> (Nacht) sind weiblich – das Wort für „gut“ passt sich an.",
          "<b>Obrigado</b> heißt wörtlich „verpflichtet“. Es richtet sich nach der Person, die spricht: Du als Mann sagst immer <b>obrigado</b>, eine Frau sagt <b>obrigada</b>."
        ],
        "vergleich": "Wie „Guten Morgen / Guten Tag / Guten Abend“ – nur dass <i>boa noite</i> auch „Guten Abend“ heißt. Englisch: good morning / good afternoon / good evening.",
        "beispiele": [
          {"pt": "Bom dia, Dona Fernanda!", "de": "Guten Morgen, Frau Fernanda!"},
          {"pt": "Boa noite e até amanhã!", "de": "Gute Nacht und bis morgen!"},
          {"pt": "Muito obrigado, senhor Rui.", "de": "Vielen Dank, Herr Rui."}
        ],
        "uebungen": [
          {"typ": "auswahl", "frage": "Es ist 9 Uhr morgens. Du triffst deine Nachbarin. Was sagst du?", "optionen": ["Boa noite!", "Bom dia!", "Boa tarde!"], "richtig": 1},
          {"typ": "auswahl", "frage": "16 Uhr – du betrittst die Apotheke. Was sagst du?", "optionen": ["Bom dia!", "Boa tarde!", "Boa noite!"], "richtig": 1, "erklaerung": "Nachmittags sagt man boa tarde."},
          {"typ": "auswahl", "frage": "Du bedankst dich bei der Kassiererin. Was sagst du als Mann?", "optionen": ["Obrigada.", "Obrigado."], "richtig": 1, "erklaerung": "Es zählt, wer spricht: Männer sagen obrigado, Frauen obrigada.", "kategorie": "obrigado/obrigada"},
          {"typ": "luecke", "satz": "___ tarde!", "loesungen": ["Boa"], "de": "Guten Tag! (nachmittags)", "erklaerung": "tarde ist weiblich → boa.", "kategorie": "Genus"},
          {"typ": "luecke", "satz": "___ dia!", "loesungen": ["Bom"], "de": "Guten Morgen!", "erklaerung": "dia ist männlich → bom.", "kategorie": "Genus"},
          {"typ": "uebersetzen", "de": "Bis morgen!", "loesungen": ["Até amanhã!"]},
          {"typ": "satzbau", "de": "Gute Nacht und bis morgen!", "loesung": "Boa noite e até amanhã!"}
        ]
      },
