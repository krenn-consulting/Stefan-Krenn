    {
      "id": "A1-01-L02",
      "typ": "neu",
      "titel": "Sich vorstellen",
      "vokabeln": ["como-se-chama", "chamo-me", "o-meu-nome-e", "muito-prazer", "igualmente", "eu", "sou", "e-ist", "ele", "ela", "o-senhor", "a-senhora", "e-und"],
      "grammatik": {
        "titel": "ser (sein) und chamar-se (heißen)",
        "erklaerung": [
          "Das Verb <b>ser</b> (sein): <b>eu sou</b> (ich bin) · <b>o senhor / a senhora é</b> (Sie sind) · <b>ele / ela é</b> (er / sie ist).",
          "Höflich spricht man in Portugal Erwachsene mit <b>o senhor</b> (zu einem Mann) bzw. <b>a senhora</b> (zu einer Frau) an – das Verb steht dabei in der 3. Person, wie bei „er/sie“. Sehr oft lässt man das Pronomen ganz weg: <i>Como se chama?</i> – Wie heißen Sie?",
          "Auch <i>eu</i> lässt man meistens weg: <b>Sou o Stefan.</b> Vor Vornamen steht in Portugal oft ein Artikel: <i>o</i> Stefan, <i>a</i> Ana.",
          "<b>Chamo-me Stefan.</b> Das kleine Wort <i>me</i> (mich) steht im europäischen Portugiesisch <b>hinter</b> dem Verb, mit Bindestrich. „Me chamo“ ist brasilianisch und klingt in Portugal falsch."
        ],
        "vergleich": "<i>Chamo-me</i> heißt wörtlich „ich nenne mich“ – wie französisch „je m'appelle“. <i>O meu nome é…</i> entspricht dem englischen „My name is…“.",
        "beispiele": [
          {"pt": "Como se chama? – Chamo-me Stefan.", "de": "Wie heißen Sie? – Ich heiße Stefan."},
